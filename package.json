{
  "name": "repotes-fonder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dashboard de asesorías Fonder Valle (Infivalle)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
